# Copiar como .env (ignorado por git) y completar.

# Entra ID: registro de la API (api-cloud)
ENTRA_TENANT_ID=
API_CLIENT_ID=

# IP privada de la VM de cada microservicio (no cambia al detener/encender la instancia)
ORDERS_URL=http://<IP-privada-ec2-orders>:8081
CATALOG_URL=http://<IP-privada-ec2-catalog>:8082
REPORT_URL=http://<IP-privada-ec2-report>:8083

# Misma clave que INTERNAL_API_KEY en catalog y report (cabecera X-Internal-Key). Nunca publicarla.
INTERNAL_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Subir a DEBUG para diagnosticar 401/403 en el BFF
SECURITY_LOG_LEVEL=INFO
